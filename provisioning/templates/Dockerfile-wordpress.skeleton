FROM wordpress:php8.4-fpm-alpine

RUN apk add --no-cache curl \
    && curl -fsSL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
       -o /usr/local/bin/wp \
    && chmod +x /usr/local/bin/wp

RUN sed -i "/That's all, stop editing! Happy publishing./i define( 'DISALLOW_FILE_MODS', true );" \
    /usr/src/wordpress/wp-config-docker.php

COPY themes/ /usr/src/wordpress/wp-content/themes/

# Set max file upload 64M
RUN printf '%s\n' \
    'upload_max_filesize = 64M' \
    'post_max_size = 64M' \
    'memory_limit = 256M' \
    'max_execution_time = 300' \
    'max_input_time = 300' \
    > /usr/local/etc/php/conf.d/uploads.ini

# Copia os temas padrão
COPY themes/ /usr/src/wordpress/wp-content/themes/


# Instala unzip
RUN apk add --no-cache unzip

# Baixa e instala as traduções
RUN set -eux; \
    WP_VERSION="$(php -r "include '/usr/src/wordpress/wp-includes/version.php'; echo \$wp_version;")"; \
    mkdir -p /tmp/wp-languages /usr/src/wordpress/wp-content/languages; \
    wget -O /tmp/pt_BR.zip \
      "https://downloads.wordpress.org/translation/core/${WP_VERSION}/pt_BR.zip"; \
    wget -O /tmp/es_ES.zip \
      "https://downloads.wordpress.org/translation/core/${WP_VERSION}/es_ES.zip"; \
    unzip -o /tmp/pt_BR.zip -d /usr/src/wordpress/wp-content/languages; \
    unzip -o /tmp/es_ES.zip -d /usr/src/wordpress/wp-content/languages; \
    rm -rf /tmp/wp-languages /tmp/pt_BR.zip /tmp/es_ES.zip

