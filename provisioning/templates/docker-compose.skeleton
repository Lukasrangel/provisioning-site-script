services:

  app:
    build:
      context: /var/www/html/{{APP_NAME}}/docker
      dockerfile: Dockerfile
    container_name: {{APP_NAME}}-app
    restart: always
    ports:
      - "127.0.0.1:{{APP_PORT}}:9000"
    environment:
      WORDPRESS_DB_HOST: mariadb
      WORDPRESS_DB_USER: {{APP_NAME}}
      WORDPRESS_DB_PASSWORD: 123456
      WORDPRESS_DB_NAME: {{APP_NAME}}
    volumes:
      - /var/www/html/{{APP_NAME}}/public:/var/www/html
    networks:
        - mariadb-user

    
networks:
    mariadb-user:
      external: true
